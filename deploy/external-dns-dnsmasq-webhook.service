[Unit]
Description=ExternalDNS webhook provider for dnsmasq
Documentation=https://github.com/kubernetes-sigs/external-dns/blob/master/docs/tutorials/webhook-provider.md
After=network-online.target dnsmasq.service
Wants=network-online.target dnsmasq.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/external-dns-dnsmasq-webhook
EnvironmentFile=-/etc/sysconfig/external-dns-dnsmasq-webhook
ExecStart=/usr/sbin/external-dns-dnsmasq-webhook
Restart=on-failure
RestartSec=5s
StateDirectory=external-dns-dnsmasq-webhook
StateDirectoryMode=0750
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/external-dns-dnsmasq-webhook
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
